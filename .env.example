# Examples only. Copy to an ignored local .env and fill only the services used.
# Never commit real values or print them in logs.

# Stage Judge: OpenAI-compatible HTTPS endpoint used after trajectory collection.
JUDGE_BASE_URL=https://your-provider.example/v1
JUDGE_MODEL=your-judge-model
JUDGE_API_KEY=

# General web discovery. Required only for the Serper-backed web-search route.
SERPER_API_KEY=
# Optional rotation keys; the implementation also accepts FALLBACK_2 ... FALLBACK_20.
SERPER_API_KEY_FALLBACK=

# Semantic Scholar. The official API can work without a key at lower limits.
S2_API_KEY=

# PubMed/PMC through NCBI E-utilities. Key is optional but recommended at scale.
NCBI_API_KEY=
NCBI_EMAIL=your-email@example.com
NCBI_TOOL=medical-research-agent-grpo

# PDF parsing. Enable one route only: MinerU cloud token OR a self-hosted base URL.
MEDGAP_PAPER_PDF_ENABLED=0
MINERU_API_TOKEN=
MEDGAP_MINERU_BASE_URL=

# Optional medical semantic verifier. The key variable is configurable; the
# default provider configuration reads DASHSCOPE_API_KEY.
MEDGAP_VERIFIER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEDGAP_VERIFIER_MODEL=qwen3.7-max-2026-06-08
MEDGAP_VERIFIER_API_KEY_ENV=DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=

# Optional semantic evidence selector. Empty values keep upstream ranking.
MEDGAP_EVIDENCE_READER_BASE_URL=
MEDGAP_EVIDENCE_READER_MODEL=
MEDGAP_EVIDENCE_READER_API_KEY=

# Optional webpage extraction fallbacks.
JINA_API_KEY=
CRAWL4AI_API_URL=
CRAWL4AI_API_KEY=
CRAWL4AI_BLOCKLIST_PATH=
